# Copy with: python scripts/setup_local.py (generates the local signing secret)
ENVIRONMENT=local
CUSTOMER_ID=local-customer
DATABASE_URL=sqlite:///./hirava.db
AUTH_MODE=local
JWT_SECRET=
TOKEN_MINUTES=30
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Server-only invitation service (separate Machine-to-Machine application).
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Client ID of the regular web application; no web client secret needed here.
AUTH0_WEB_CLIENT_ID=
AUTH0_CONNECTION=Username-Password-Authentication
RMS_ENABLED=true
# Optional screening pilot. Enable only after choosing a model and approving data use.
AI_SCREENING_ENABLED=false
AI_RECRUITER_TOOLS_ENABLED=false
AI_VOICE_INTERVIEWS_ENABLED=false
VOICE_REALTIME_MODEL=gpt-realtime-mini
VOICE_REALTIME_MAX_MINUTES=5
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VOICE_SPEECH_MODEL=gpt-4o-mini-tts
VOICE_NAME=coral
AI_SCREENING_ON_INTAKE=false
# Existing active Admin/HR/Recruiter in this customer; authorizes configured automation.
AI_SCREENING_INTAKE_ACTOR_ID=
# Shared selection for AI agents. Restart the API after changes.
AI_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
GROQ_MODEL=openai/gpt-oss-120b
# Legacy *_SCREENING_* selectors remain supported only when shared fields are absent.
AI_SCREENING_PROVIDER=openai
GROQ_API_KEY=
GROQ_SCREENING_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_SCREENING_MODEL=
AI_TIMEOUT_SECONDS=60
HRMS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Retried private-file cleanup runs inside FastAPI; disable for read-only diagnostics.
IMPORTED_STORAGE_CLEANUP_ENABLED=true
MAX_UPLOAD_BYTES=10485760
EXPOSE_DOCS=true

# Keep empty: all retained business endpoints run in FastAPI.
# A non-empty value is rejected; the Node backend has been removed.
LEGACY_API_URL=
AWS_REGION=
# Required for all document, photo and resume storage. No local fallback.
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional server-side interview email provider.
SENDGRID_API_KEY=
SENDGRID_VERIFIED_SENDER=
# Optional subscription confirmation/team email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
TEAM_NOTIFICATION_EMAIL=

# Optional Docker PostgreSQL; generated by setup_local.py.
POSTGRES_USER=hirava
POSTGRES_PASSWORD=
POSTGRES_DB=hirava
POSTGRES_PORT=5432

# Production profile requires AUTH_MODE=auth0, EXPOSE_DOCS=false,
# HTTPS origins, and a postgresql+psycopg://... DATABASE_URL.
# AI requires its optional dependencies, migration, enabled flag and explicit reviewer action.

# Periodic internal work detection; no external messages or AI calls.
RECRUITMENT_OPERATIONS_ENABLED=false
