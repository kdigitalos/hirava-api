# Copy with: python scripts/setup_local.py (generates the local signing secret)
ENVIRONMENT=local
CUSTOMER_ID=local-customer
DATABASE_URL=sqlite:///./hirava.db
AUTH_MODE=local
JWT_SECRET=
TOKEN_MINUTES=30
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
RMS_ENABLED=true
HRMS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_PATH=./storage
MAX_UPLOAD_BYTES=10485760
EXPOSE_DOCS=true

# Optional Docker PostgreSQL; generated by setup_local.py.
POSTGRES_USER=hirava
POSTGRES_PASSWORD=
POSTGRES_DB=hirava
POSTGRES_PORT=5432

# Production profile requires AUTH_MODE=auth0, EXPOSE_DOCS=false,
# HTTPS origins, and a postgresql+psycopg://... DATABASE_URL.
# External providers and AI are not enabled by environment flags.
